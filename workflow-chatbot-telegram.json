{
  "name": "Chatbot Telegram - Temperatura (OpenWeather)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "a1f3c2d4-0001-4b6e-9a10-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "webhookId": "b7e2a9c1-5d3f-4e8a-9c21-7f6d4e3b2a10"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c1a2b3c4-0001-4d5e-8f90-000000000011",
              "name": "queue",
              "value": "={{ ($json.message.text ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim().replace(/\\s*,\\s*/g, ',').replace(/\\s+/g, ' ').replace(/(,br)?$/, ',br') }}",
              "type": "string"
            },
            {
              "id": "c1a2b3c4-0002-4d5e-8f90-000000000012",
              "name": "chatId",
              "value": "={{ $json.message.chat.id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f3c2d4-0002-4b6e-9a10-000000000002",
      "name": "Normalizar Cidade",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "queue",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "a1f3c2d4-0003-4b6e-9a10-000000000003",
      "name": "Consultar OpenWeather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1e2f3a4-0001-4b5c-8d9e-000000000021",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "d1e2f3a4-0002-4b5c-8d9e-000000000022",
              "leftValue": "={{ $json.body?.main?.temp }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "d1e2f3a4-0003-4b5c-8d9e-000000000023",
              "leftValue": "={{ $json.body?.name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1f3c2d4-0004-4b6e-9a10-000000000004",
      "name": "Resposta Válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extrai cidade e temperatura e monta a mensagem final\nconst { name, main } = $json.body;\nconst temperatura = Math.round(main.temp);\n\nreturn {\n  json: {\n    chatId: $('Normalizar Cidade').item.json.chatId,\n    message: `🌤️ A temperatura em ${name} é de ${temperatura}°C.`\n  }\n};"
      },
      "id": "a1f3c2d4-0005-4b6e-9a10-000000000005",
      "name": "Formatar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1f3c2d4-0006-4b6e-9a10-000000000006",
      "name": "Enviar Temperatura",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        200
      ],
      "webhookId": "e4c1b2a3-6d5f-4a7e-8b90-1c2d3e4f5a60"
    },
    {
      "parameters": {
        "chatId": "={{ $('Normalizar Cidade').item.json.chatId }}",
        "text": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1f3c2d4-0007-4b6e-9a10-000000000007",
      "name": "Enviar Erro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        420
      ],
      "webhookId": "f5d2c3b4-7e6a-4b8f-9ca1-2d3e4f5a6b70"
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Normalizar Cidade",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar Cidade": {
      "main": [
        [
          {
            "node": "Consultar OpenWeather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar OpenWeather": {
      "main": [
        [
          {
            "node": "Resposta Válida?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resposta Válida?": {
      "main": [
        [
          {
            "node": "Formatar Mensagem",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar Erro",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatar Mensagem": {
      "main": [
        [
          {
            "node": "Enviar Temperatura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
